# ==========================================================
# MIAMI_2027 (Vice City Edition) — Configurações
# Copie este arquivo para backend/.env para configurar o servidor
# ==========================================================

# 1. Banco de Dados Local (SQLite)
DATABASE_PATH=data/miami2027.sqlite

# 2. CORS (Origens permitidas no Frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 3. Opção A — Envio de E-mail via Gmail SMTP (Gratuito)
# Gere uma "Senha de App" em: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM_NAME=Missão Miami 2027 - Vice City

# 4. Opção B — Envio de E-mail via Resend API (Gratuito até 3.000 e-mails/mês)
# Crie uma chave em: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

